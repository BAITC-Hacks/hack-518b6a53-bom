LOG_LEVEL=INFO
# Заполните оба поля для настоящего AI-объяснения. Ключ не коммитьте.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_OUTPUT_TOKENS=900
# Таймаут UI должен быть больше OPENAI_TIMEOUT_SECONDS.
API_PROXY_TIMEOUT_SECONDS=60
# При запуске Node вне Docker. В Compose используется http://api:8000.
API_URL=http://127.0.0.1:8000
